# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_telegram_user_id

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SHEETS_CREDENTIALS_FILE=path/to/service-account.json

# AI Evaluation Configuration
# Use 'anthropic' or 'openai'
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# AI Model Selection
# For Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
# For OpenAI: gpt-4o, gpt-4-turbo, etc.
AI_MODEL=claude-3-5-sonnet-20241022

# Application Settings
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,mp4,mov
HOMEPAGE_URL=https://yourcompany.com
INTERVIEW_LINK=https://calendly.com/akademischesghosteditor/30min

# Deployment Settings
MODE=polling
WEBHOOK_URL=https://railway-app-placeholder.up.railway.app
PORT=8080
